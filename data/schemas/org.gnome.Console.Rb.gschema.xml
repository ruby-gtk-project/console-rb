<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="console-rb">
  <enum id="org.gnome.Console.Rb.Theme">
    <value nick="auto" value="0"/>
    <value nick="night" value="1"/>
    <value nick="day" value="2"/>
    <!-- Deprecated: interpreted as 'night' -->
    <value nick="hacker" value="3"/>
  </enum>

  <schema id="org.gnome.Console.Rb" path="/org/gnome/Console/Rb/">
    <key name="theme" enum="org.gnome.Console.Rb.Theme">
      <default>'night'</default>
    </key>
    <key name="font-scale" type="d">
      <range min="0.5" max="4.0"/>
      <default>1.0</default>
    </key>
    <key name="custom-font" type="s">
      <default>""</default>
    </key>
    <key name="use-system-font" type="b">
      <default>true</default>
    </key>
    <key name="shell" type="as">
      <default>[]</default>
    </key>
    <key name="ignore-scrollback-limit" type="b">
      <default>false</default>
    </key>
    <key name="scrollback-lines" type="x">
      <default>10000</default>
    </key>
    <key name="last-window-size" type="(ii)">
      <default>(-1, -1)</default>
    </key>
    <key name="last-window-maximised" type="b">
      <default>false</default>
    </key>
    <key name="last-window-fullscreen" type="b">
      <default>false</default>
    </key>
    <key name="restore-window-size" type="b">
      <default>true</default>
    </key>
    <key name="audible-bell" type="b">
      <default>true</default>
    </key>
    <key name="visual-bell" type="b">
      <default>true</default>
    </key>
    <key name="software-flow-control" type="b">
      <default>false</default>
    </key>
    <key name="transparency" type="b">
      <default>false</default>
    </key>
    <key name="livery" type="s">
      <default>'9f1374fd-f199-429f-bae6-9cf1260f6e3e'</default>
    </key>
    <!-- A JSON object keyed by uuid. Upstream uses a GVariant a{sv}; the Ruby
         GLib::Variant binding cannot read a vardict, so this port stores the
         same data as JSON. See PORTING.md. -->
    <key name="custom-liveries" type="s">
      <default>'{}'</default>
    </key>
    <key name="always-stop-train" type="b">
      <default>false</default>
      <summary>Bypass the 'Close Tab?' or 'Close Window?' dialogues</summary>
    </key>
  </schema>
</schemalist>
