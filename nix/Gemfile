# frozen_string_literal: true

# The app's RUNTIME gems, for bundlerEnv in flake.nix. Generated by
# converge-port-gem.sh from the gemspec; do not edit by hand.
#
# The Gemfile at the repo root is kettle-jem's development bundle —
# rubocop, rspec, yard and the kettle-dev stack — and must not end up in
# a packaged app's closure.
source "https://rubygems.org"

gem "adwaita"
gem "gtk4"
gem "vte4"

# GTop: upstream reads per-process statistics through libgtop. The gem loads
# but its functions are not callable from Ruby (FINDINGS.md #17), so
# lib/console_rb/process_info.rb reads /proc directly instead; the dependency
# stays declared because it is still a real runtime dependency and keeps the
# typelib wiring in flake.nix documented.
gem "libgtop"

# Translation lookup shares GNOME Console's own gettext catalogue.
gem "gettext"
